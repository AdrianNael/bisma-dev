<!DOCTYPE html>
<html lang="en" style="margin:0; padding:0;">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        /* Puppeteer PDF Generation - Modern CSS with fixed header/footer */

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Times New Roman', serif;
            font-size: 16px;
            margin: 0;
            padding: 0;
            position: relative;
        }

        /* Main Content - tidak terpotong */
        main.page-content {
            padding: 5mm 10mm 5mm 10mm;
            /* top right bottom left: kiri 10mm, kanan 5mm */
            min-height: auto;
        }

        /* Table styling */
        table {
            page-break-inside: auto;
            border-collapse: collapse;
            table-layout: fixed;
            width: 100%;
            margin: 3mm 0 5mm 0;
            /* Top margin lebih besar untuk jarak dari info mahasiswa */
        }

        @media print {
            thead {
                display: table-row-group;
            }
        }

        tr {
            page-break-inside: avoid !important;
        }

        th,
        td {
            border: 0.5px solid #000;
            padding: 8px;
            text-align: center;
            /* allow long words/URLs to wrap inside table cells */
            word-break: break-word;
            overflow-wrap: anywhere;
            white-space: normal;
        }

        th {
            background-color: #b5c5e7;
            font-weight: bold;
        }

        /* Column width adjustments - sesuai screenshot */
        table td:nth-child(1),
        table th:nth-child(1) {
            width: 4%;
        }

        /* No */
        table td:nth-child(2),
        table th:nth-child(2) {
            width: 8%;
        }

        /* Tanggal */
        table td:nth-child(3),
        table th:nth-child(3) {
            width: 10%;
        }

        /* Kategori Kegiatan */
        table td:nth-child(4),
        table th:nth-child(4) {
            width: 28%;
        }

        /* Rincian Kegiatan */
        table td:nth-child(5),
        table th:nth-child(5) {
            width: 8%;
        }

        /* Waktu Mulai */
        table td:nth-child(6),
        table th:nth-child(6) {
            width: 8%;
        }

        /* Waktu Selesai */
        table td:nth-child(7),
        table th:nth-child(7) {
            width: 7%;
        }

        /* Jumlah Jam Kerja */
        table td:nth-child(8),
        table th:nth-child(8) {
            width: 27%;
        }

        /* Tautan Dokumen Output */

        /* Prevent the 'No.' header/number from being split across lines */
        table td:nth-child(1),
        table th:nth-child(1) {
            white-space: nowrap;
            word-break: normal;
            overflow-wrap: normal;
        }

        /* Signature area styling - will flow naturally after table */
        .signature-container {
            margin-top: 8mm;
            page-break-inside: avoid !important;
            min-height: 80mm;
        }
    </style>
</head>

<body>
    <main class="page-content">
        <!-- Header (renders once as part of document content -> appears only on first page) -->


        <% if (result.data.length==0) { %>
            <div style="text-align:center">
                <h2>Data Not Found!</h2>
            </div>
            <% } else { %>
                <div style="font-family:'Times New Roman'; line-height:1; font-weight:bold; margin-bottom:2m;">
                    <p style="margin:2mm 0;">Nama&emsp;: <%= result.student ? result.student.nama : (result.data[0] ?
                            result.data[0].nama : '-' ) %>
                    </p>
                    <p style="margin:2mm 0;">NIM&emsp;&nbsp;: <%= result.student ? result.student.NIM : (result.data[0]
                            ? result.data[0].NIM : '-' ) %>
                    </p>
                    <p style="margin:2mm 0;">Prodi&emsp;: <%= result.student ? result.student.departemen :
                            (result.data[0] ? result.data[0].departemen : '-' ) %>
                    </p>
                </div>

                <% function formatDMY(dateStr){ if(!dateStr) return '-' ; const d=new Date(dateStr); if(isNaN(d)) return
                    dateStr; const dd=('0'+d.getDate()).slice(-2); const mm=('0'+(d.getMonth()+1)).slice(-2); const
                    yy=String(d.getFullYear()).slice(-2); return dd+'/'+mm+'/'+yy; } %>

                    <table cellspacing="0" cellpadding="8">
                        <thead>
                            <tr>
                                <th style="background-color:#b5c5e7">No.</th>
                                <th style="background-color:#b5c5e7">Tanggal</th>
                                <th style="background-color:#b5c5e7">Kategori Kegiatan</th>
                                <th style="background-color:#b5c5e7">Rincian Kegiatan</th>
                                <th style="background-color:#b5c5e7">Waktu Mulai</th>
                                <th style="background-color:#b5c5e7">Waktu Selesai</th>
                                <th style="background-color:#b5c5e7">Jumlah Jam Kerja</th>
                                <th style="background-color:#b5c5e7">Tautan Dokumen Output Pekerjaan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% function safeNumber(v){ v=v || 0; const n=Number(v); return isNaN(n) ? 0 : n; } let
                                            rowNumber=0; let sumJam=0; for (let i=0; i < result.data.length; i++) { const
                                            data=result.data[i]; rowNumber++; sumJam +=safeNumber(data.total_sesi); %>
                                            <% function formatNumber(v){ if(v===null||v===undefined||v==='') return '-'; const n=Number(v); if(isNaN(n)) return v; const fixed=n.toFixed(2); if(fixed.endsWith('.00')) return String(Math.round(n)); return fixed.replace('.', ','); } %>
                                <tr>
                                    <td>
                                        <%= rowNumber %>
                                    </td>
                                    <td>
                                        <%= formatDMY(data.tanggal) %>
                                    </td>
                                    <td>
                                        <%= data.kegiatan || data.kategori_magang || '-' %>
                                    </td>
                                    <td style="text-align:left;">
                                        <%= data.deskripsi || '-' %>
                                    </td>
                                    <td>
                                        <%= data.jam_mulai %>
                                    </td>
                                    <td>
                                        <%= data.jam_selesai %>
                                    </td>
                                    <td>
                                        <%= Number((data.total_sesi || 0) * 60).toFixed(0) %> Menit
                                    </td>
                                    <td
                                        style="text-align:left; word-break:break-word; overflow-wrap:anywhere; white-space:normal;">
                                        <% if (data.link_output) { %>
                                            <a href="<%= data.link_output %>" target="_blank"
                                                style="color:inherit; text-decoration:none; word-break:break-word; overflow-wrap:anywhere;">
                                                <%= data.link_output %>
                                            </a>
                                            <% } else { %>
                                                -
                                                <% } %>
                                    </td>
                                </tr>
                                <% } %>
                                    <tr style="border-top: 1px solid #000;">
                                        <td colspan="6"
                                            style="text-align:center; font-weight: bold; background-color: transparent;">
                                            Total Sesi Menit</td>
                                        <td style="font-weight: bold; background-color: transparent;">
                                            <%= Number(sumJam * 60).toFixed(0) %> Menit
                                        </td>
                                        <td style="text-align:center; background-color: transparent;">

                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="6"
                                            style="text-align:center; font-weight: bold; background-color: transparent;">
                                            Total Sesi Jam / 60 Menit</td>
                                        <td style="font-weight: bold; background-color: transparent;">
                                            <%= formatNumber(sumJam) %>
                                        </td>
                                        <td style="text-align:center; background-color: transparent;">

                                        </td>
                                    </tr>
                        </tbody>
                    </table>

                    <!-- Signature Section - richer layout like timesheet.ejs -->
                    <div class="signature-container"
                        style="display: flex; justify-content: space-between; padding: 6mm 5mm;">
                        <!-- Left Signature (Penanggungjawab) -->
                        <div style="width: 45%; text-align: center;">
                            <p style="margin: 0 0 2mm 0; font-size: 16px; font-weight: bold;">Penanggungjawab,</p>
                            <p style="margin: 0 0 3mm 0; font-size: 16px; font-weight: bold;">
                                <%= jabatan || 'Dosen Pembimbing' %>
                            </p>

                            <% if (result.signatures && result.signatures.lecturer) { %>
                                <div
                                    style="height: 70px; display: flex; align-items: center; justify-content: center; margin-top: 5mm; margin-bottom: 5mm;">
                                    <img src="<%= result.signatures.lecturer %>" alt="Lecturer Signature"
                                        style="max-height: 100px; max-width: 250px;" />
                                </div>
                                <% } else { %>
                                    <div
                                        style="height: 100px; border: 1px dashed #999; display: flex; align-items: center; justify-content: center; margin: 0 auto 5mm auto; width: 250px; color: #999; font-weight: bold;">
                                        (Tanda Tangan)
                                    </div>
                                    <% } %>

                                        <p style="margin: 0; font-weight: bold; font-size: 16px;">
                                            <%= (result.lecturer && result.lecturer.nama) ? result.lecturer.nama : '-'
                                                %>
                                        </p>
                                        <% const lecturerId=(result.lecturer && result.lecturer.id) ? result.lecturer.id
                                            : null; const lecturerStatus=(result.lecturer && result.lecturer.status) ?
                                            result.lecturer.status : null; %>
                                            <% if (lecturerStatus==='STAF' && lecturerId) { %>
                                                <p style="margin: 2mm 0 0 0; font-size: 16px; font-weight: bold;">NIP.
                                                    <%= lecturerId %>
                                                </p>
                                                <% } else if (lecturerId) { %>
                                                    <p style="margin: 2mm 0 0 0; font-size: 16px; font-weight: bold;">
                                                        <%= lecturerId %>
                                                    </p>
                                                    <% } %>
                        </div>

                        <!-- Right Signature (Mahasiswa) -->
                        <div style="width: 45%; text-align: center;">
                            <p style="margin: 0 0 2mm 0; font-size: 16px; font-weight: bold;">Mahasiswa,</p>
                            <p style="margin: 0 0 3mm 0; font-size: 16px; font-weight: bold;">&nbsp;</p>

                            <% if (result.signatures && result.signatures.student) { %>
                                <div
                                    style="height:70px; margin-top: 5mm; display: flex; align-items: center; justify-content: center; margin-bottom: 5mm;">
                                    <img src="<%= result.signatures.student %>" alt="Student Signature"
                                        style="max-height: 100px; max-width: 250px;" />
                                </div>
                                <% } else { %>
                                    <div
                                        style="height: 100px; border: 1px dashed #999; display: flex; align-items: center; justify-content: center; margin: 0 auto 5mm auto; width: 250px; color: #999; font-weight: bold;">
                                        (Tanda Tangan)
                                    </div>
                                    <% } %>

                                        <p style="margin: 0; font-weight: bold; font-size: 16px;">
                                            <%= result.student ? result.student.nama : (result.data[0] ?
                                                result.data[0].nama : '-' ) %>
                                        </p>
                                        <% const studentNim=result.student ? result.student.NIM : (result.data[0] ?
                                            result.data[0].NIM : null); %>
                                            <% if (studentNim) { %>
                                                <p style="margin: 2mm 0 0 0; font-size: 16px; font-weight: bold;">NIM.
                                                    <%= studentNim %>
                                                </p>
                                                <% } %>
                        </div>
                    </div>
                    <% } %>
    </main>
</body>

</html>
  <style>
    @page {
      size: A4 landscape;
      margin: 10mm 10mm 35mm 10mm;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Times New Roman', Times, serif;
      font-size: 11px;
      color: #000;
    }

    .page-wrapper {
      width: 100%;
    }

    .page-container {
      width: 100%;
    }

    /* Footer now handled by phantom footer in optionsRekap */
    .header-section {
      margin-bottom: 4mm;
    }

    .header-section table {
      border-collapse: collapse;
    }

    .form-title {
      text-align: center;
      font-size: 14px;
      font-weight: bold;
      margin: 6mm 0;
      line-height: 1.4;
      font-family: 'Times New Roman', Times, serif;
    }

    table.data-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      font-size: 12px;
      margin-bottom: 6mm;
      margin-top: 35mm;
      font-family: 'Times New Roman', Times, serif;
      border: 1px solid #000;
    }


    table.data-table th,
    table.data-table td {
      border: 1px solid #000;
      padding: 3mm 2mm;
      text-align: center;
      vertical-align: middle;
    }

    table.data-table th {
      background-color: #99CCFF;
      font-weight: bold;
      font-size: 15px;
      line-height: 1.2;
    }

    table.data-table .col-no {
      width: 26px;
    }

    table.data-table .col-nama {
      width: 160px;
      text-align: center;
      padding-left: 3mm;
    }

    table.data-table .col-nim {
      width: 90px;
    }

    table.data-table .col-date {
      width: 36px;
    }

    table.data-table .col-total-design {
      width: 80px;
    }

    table.data-table .col-total-insentif {
      width: 100px;
      text-align: center;
      padding-right: 3mm;
    }

    table.data-table .total-row {
      font-weight: bold;
      font-size: 15px;
    }

    .signature-section {
      display: flex;
      justify-content: space-between;
      padding: 0 5mm;
      margin-top: 2mm;
      margin-bottom: 0mm;
      font-size: 17px;
      font-family: 'Times New Roman', Times, serif;
    }

    .signature-section .signature-box {
      width: 45%;
      margin-left: 760px;
      text-align: left;
      font-family: 'Times New Roman', Times, serif;
    }

    .signature-image-wrapper {
      height: 70px;
      display: flex;
      align-items: left;
      justify-content: left;
      margin-top: 5mm;
      margin-bottom: 10mm;
      margin-left: -10px;
    }

    .signature-placeholder {
      height: 100px;
      border: 1px dashed #999;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 5mm auto;
      width: 250px;
      color: #999;
      font-weight: bold;
    }

    .signature-section p {
      margin: 1mm 0;
    }

    .signature-space {
      height: 30mm;
    }
  </style>
</head>


              <table class="data-table">
                <thead>
                  <% const monthNames=['Januari', 'Februari' , 'Maret' , 'April' , 'Mei' , 'Juni' , 'Juli' , 'Agustus'
                    , 'September' , 'Oktober' , 'November' , 'Desember' ]; function formatFullDate(dateStr) { const
                    date=new Date(dateStr); return `${date.getDate()} ${monthNames[date.getMonth()]}
                    ${date.getFullYear()}`; } %>
                    <tr>
                      <th class="col-no">NO</th>
                      <th class="col-nama">NAMA<br>MAHASISWA</th>
                      <th class="col-nim">NIM</th>
                      <% if (result.sortedDates && result.sortedDates.length> 0) { %>
                        <% result.sortedDates.forEach((dateStr, index)=> { %>
                          <th class="col-date">
                            <%= formatFullDate(dateStr) %>
                          </th>
                          <% }); %>
                            <% } %>
                              <th class="col-total-design">TOTAL<br>DESAIN</th>
                              <th class="col-total-insentif">TOTAL<br>INSENTIF</th>
                    </tr>
                </thead>
                <tbody>
                  <% result.data.forEach((mhs, index)=> { %>
                    <tr>
                      <td class="col-no">
                        <%= mhs.no %>
                      </td>
                      <td class="col-nama">
                        <%= mhs.nama %>
                      </td>
                      <td class="col-nim">
                        <%= mhs.nim %>
                      </td>
                      <% let rowTotalDesign=0; if (result.sortedDates && result.sortedDates.length> 0) {
                        result.sortedDates.forEach((date) => {
                        rowTotalDesign += (mhs.dateMap[date] || 0);
                        });
                        }
                        %>
                        <% if (result.sortedDates && result.sortedDates.length> 0) { %>
                          <% result.sortedDates.forEach((date, dateIndex)=> { %>
                            <% const designCount=mhs.dateMap[date] || 0; %>
                              <% const designStr=designCount> 0 ? String(designCount) : '-'; %>
                                <td class="col-date <%= dateIndex === 0 ? 'first-month' : '' %>">
                                  <%= designStr %>
                                </td>
                                <% }); %>
                                  <% } %>
                                    <td class="col-total-design">
                                      <%= rowTotalDesign %>
                                    </td>
                                    <td class="col-total-insentif">Rp<%= mhs.total_insentif.toLocaleString('id-ID') %>
                                    </td>
                    </tr>
                    <% }); %>
                      <tr class="total-row">
                        <td colspan="<%= 3 + (result.sortedDates ? result.sortedDates.length : 0) %>">TOTAL</td>
                        <% let grandTotalDesign=0; if (result.data && result.sortedDates) { result.data.forEach((mhs)=>
                          {
                          result.sortedDates.forEach((date) => {
                          grandTotalDesign += (mhs.dateMap[date] || 0);
                          });
                          });
                          }
                          %>
                          <td class="col-total-design">
                            <%= grandTotalDesign %> Desain
                          </td>
                          <td class="col-total-insentif">Rp<%= result.total.total_insentif.toLocaleString('id-ID') %>
                          </td>
                      </tr>
                </tbody>
              </table>
              <div class="signature-section">
                <div></div>
                <div class="signature-box">
                  <p style="margin: 0 0 2mm 0; font-size: 16px;">Mengetahui,</p>
